{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldclassconsultants.gr/migration-stream/schemas/engagement/object-pack-manifest.schema.json",
  "title": "Migration Stream Server-Controlled Object Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "title",
    "scope",
    "rootEntityId",
    "profileFile",
    "profileSha256",
    "mappingSuggestions",
    "referenceTables",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "scope": {
      "$ref": "#/$defs/detail"
    },
    "rootEntityId": {
      "$ref": "#/$defs/domainId"
    },
    "mappingMode": {
      "enum": [
        "CONTROLLED_SUGGESTIONS",
        "OPERATOR_GOVERNED"
      ]
    },
    "profileFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*[.]json$"
    },
    "profileSha256": {
      "$ref": "#/$defs/sha256"
    },
    "mappingSuggestions": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mappingSuggestion"
      }
    },
    "referenceTables": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/referenceTable"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/detail"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "domainId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 32,
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "sourceFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]*(/[A-Za-z0-9][A-Za-z0-9._ -]*)*$"
    },
    "sourceColumn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "mappingSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestionId",
        "targetFieldId",
        "kind"
      ],
      "properties": {
        "suggestionId": {
          "$ref": "#/$defs/id"
        },
        "sourceFile": {
          "$ref": "#/$defs/sourceFile"
        },
        "sourceColumn": {
          "$ref": "#/$defs/sourceColumn"
        },
        "sourceColumnOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "targetFieldId": {
          "$ref": "#/$defs/domainId"
        },
        "targetEntityId": {
          "$ref": "#/$defs/domainId"
        },
        "kind": {
          "enum": [
            "direct",
            "trim",
            "empty_as_null",
            "constant",
            "uppercase_ascii",
            "lowercase_ascii",
            "lookup"
          ]
        },
        "constant": {
          "type": "string",
          "maxLength": 4096
        },
        "lookupTableId": {
          "$ref": "#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "constant"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "constant"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sourceFile"
                  ]
                },
                {
                  "required": [
                    "sourceColumn"
                  ]
                },
                {
                  "required": [
                    "sourceColumnOrdinal"
                  ]
                },
                {
                  "required": [
                    "lookupTableId"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "sourceFile",
              "sourceColumn",
              "sourceColumnOrdinal"
            ],
            "not": {
              "required": [
                "constant"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "lookup"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "lookupTableId"
            ]
          },
          "else": {
            "not": {
              "required": [
                "lookupTableId"
              ]
            }
          }
        }
      ]
    },
    "referenceTable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tableId",
        "version",
        "values"
      ],
      "properties": {
        "tableId": {
          "$ref": "#/$defs/id"
        },
        "entityId": {
          "$ref": "#/$defs/domainId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 10000,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 4096
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    }
  }
}
