{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldclassconsultants.gr/migration-stream/schemas/validation-policy.schema.json",
  "title": "Migration Stream Validation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rowBatchSize",
    "maximumIssues",
    "maximumPatternBytes",
    "maximumTotalPatternBytes",
    "maximumPatternProgramBytes",
    "maximumLookupEntries",
    "maximumLookupBytes",
    "maximumUniqueKeys",
    "maximumUniqueKeyBytes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rowBatchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maximumIssues": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maximumPatternBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "maximumTotalPatternBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maximumPatternProgramBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 67108864
    },
    "maximumLookupEntries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maximumLookupBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "maximumUniqueKeys": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000
    },
    "maximumUniqueKeyBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    }
  }
}
