  "$id": "https://worldclassconsultants.gr/migration-stream/schemas/wp003-governed-evidence-v2.schema.json",
  "title": "Migration Stream WP-003 Governed End-to-End and Storage Evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_at_utc",
    "execution_context",
    "subject",
    "method",
    "end_to_end",
    "storage",
    "fixed_sql_access_path",
    "assertions",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "migration-stream-governed-evidence/v2"
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
