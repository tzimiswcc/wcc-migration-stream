        "payload_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measurement_method": {
                "const": "sqlite-dbstat-private-copy"
              }
            },
            "required": [
              "measurement_method"
            ]
          },
          "then": {
            "properties": {
              "dbstat_bytes": {
                "$ref": "#/$defs/nonnegativeInteger"
              },
              "payload_bytes": {
                "$ref": "#/$defs/nonnegativeInteger"
              }
