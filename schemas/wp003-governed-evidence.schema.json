    "execution_context": {
      "$ref": "#/$defs/executionContext"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "end_to_end": {
      "$ref": "#/$defs/endToEnd"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "fixed_sql_access_path": {
      "$ref": "#/$defs/fixedSql"
    },
    "assertions": {
      "$ref": "#/$defs/textList"
    },
    "limitations": {
      "$ref": "#/$defs/textList"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "executionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_revision",
        "git_clean",
        "executable_sha256",
        "executable_bytes",
        "executable_format",
        "executable_platform",
        "executable_architectures",
        "binary_revision_binding",
        "process_platform",
        "process_architecture",
        "host_platform",
        "host_architecture",
        "native_execution_verified",
        "rustc_release",
        "rustc_host_triple",
        "rustc_default_target_triple",
        "rustc_target_platform",
        "rustc_target_architecture",
        "rustc_target_basis",
        "evidence_schema_path",
        "evidence_schema_sha256",
        "context_sha256"
      ],
      "properties": {
        "git_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "git_clean": {
          "type": "boolean"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executable_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
