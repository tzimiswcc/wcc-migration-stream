        "executable_format": {
          "enum": [
            "elf",
            "macho",
            "pe"
          ]
        },
        "executable_platform": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "executable_architectures": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "x86_64",
              "aarch64"
            ]
          }
        },
        "binary_revision_binding": {
          "const": "co-recorded-no-embedded-attestation"
        },
        "process_platform": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
        },
        "process_architecture": {
          "enum": [
            "x86_64",
            "aarch64"
          ]
        },
        "host_platform": {
          "enum": [
            "linux",
            "macos",
            "windows"
          ]
