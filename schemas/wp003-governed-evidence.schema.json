        "product_query_guard_ms",
        "command_timeout_seconds",
        "outer_timeout_seconds",
        "maximum_database_bytes",
        "maximum_wal_bytes",
        "maximum_output_tree_bytes",
        "maximum_captured_output_bytes",
        "page_size",
        "sqlite_source_strategy",
        "child_process_containment",
        "storage_method",
