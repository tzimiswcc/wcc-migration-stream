{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldclassconsultants.gr/migration-stream/schemas/read/profile-view.schema.json",
  "title": "Migration Stream Profile View v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "data", "canonical_hash"],
  "properties": {
    "schema_version": { "const": "migration-stream/read/profile-view/v1" },
    "data": { "$ref": "#/$defs/profile" },
    "canonical_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 64 },
    "state": { "enum": ["GENERATED_DRAFT", "REVIEWED_DRAFT", "APPROVED", "DEPRECATED", "RETIRED"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "approver", "reason", "acknowledged", "approved_at", "approval_hash"],
      "properties": {
        "approval_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approver": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "acknowledged": { "const": true },
        "approved_at": { "$ref": "#/$defs/timestamp" },
        "approval_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "lifecycleEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence", "from_state", "to_state", "actor", "reason",
        "previous_event_hash", "event_hash", "occurred_at"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "from_state": { "anyOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
        "to_state": { "$ref": "#/$defs/state" },
        "actor": { "type": "string", "minLength": 1, "maxLength": 256 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "previous_event_hash": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "event_hash": { "$ref": "#/$defs/sha256" },
        "occurred_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id", "profile_version", "profile_hash", "schema_hash", "document",
        "declared_status", "validation_hash", "registered_at", "lifecycle_state",
        "approvals", "lifecycle_events"
      ],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "profile_version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "profile_hash": { "$ref": "#/$defs/sha256" },
        "schema_hash": { "$ref": "#/$defs/sha256" },
        "document": {
          "$comment": "The embedded immutable document is independently governed by migration-object-profile.schema.json.",
          "type": "object",
          "maxProperties": 32
        },
        "declared_status": { "$ref": "#/$defs/state" },
        "validation_hash": { "$ref": "#/$defs/sha256" },
        "registered_at": { "$ref": "#/$defs/timestamp" },
        "lifecycle_state": { "$ref": "#/$defs/state" },
        "approvals": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/approval" }
        },
        "lifecycle_events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/lifecycleEvent" }
        }
      }
    }
  }
}
