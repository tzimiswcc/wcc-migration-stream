{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldclassconsultants.gr/migration-stream/schemas/http/workbench-context.schema.json",
  "title": "Migration Stream Workbench Startup Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "read_only",
    "workspace_label",
    "job_id",
    "profiling_run_id",
    "selected_governance",
    "supported_contracts"
  ],
  "properties": {
    "schema_version": {
      "const": "migration-stream/workbench/context/v1"
    },
    "read_only": {
      "const": true
    },
    "workspace_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "job_id": {
      "$ref": "#/$defs/identifier"
    },
    "profiling_run_id": {
      "anyOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "selected_governance": {
      "anyOf": [
        { "$ref": "#/$defs/governance" },
        { "type": "null" }
      ]
    },
    "supported_contracts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "migration-stream/read/job-summary/v1",
          "migration-stream/read/file-manifest/v1",
          "migration-stream/read/profiling-summary/v1",
          "migration-stream/read/profile-view/v1",
          "migration-stream/read/mapping-coverage/v1",
          "migration-stream/read/validation-summary/v1",
          "migration-stream/read/issue-list/v1",
          "migration-stream/read/row-detail/v1",
          "migration-stream/read/reconciliation-summary/v1",
          "migration-stream/read/operational-cleanup/v1"
        ]
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_hash",
        "mapping_id",
        "mapping_version",
        "mapping_hash",
        "validation_run_id",
        "validation_state"
      ],
      "properties": {
        "profile_id": { "$ref": "#/$defs/identifier" },
        "profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "profile_hash": { "$ref": "#/$defs/sha256" },
        "mapping_id": { "$ref": "#/$defs/identifier" },
        "mapping_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "mapping_hash": { "$ref": "#/$defs/sha256" },
        "validation_run_id": { "$ref": "#/$defs/identifier" },
        "validation_state": {
          "enum": [
            "RUNNING",
            "COMPLETE",
            "FAILED",
            "INTERRUPTED",
            "BOUND_EXCEEDED"
          ]
        }
      }
    }
  }
}
