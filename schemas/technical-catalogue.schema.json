{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldclassconsultants.gr/migration-stream/schemas/technical-catalogue.schema.json",
  "title": "Migration Stream Generated Technical Catalogue Artifact",
  "description": "Deterministic technical evidence imported from an immutable EDMX snapshot. This artifact is never an approved Migration Object Profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalogue",
    "evidence"
  ],
  "properties": {
    "catalogue": {
      "$ref": "#/$defs/catalogue"
    },
    "evidence": {
      "$ref": "#/$defs/hashEvidence"
    }
  },
  "$defs": {
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "status",
        "snapshot",
        "parser",
        "schemas"
      ],
      "properties": {
        "formatVersion": {
          "const": "1.0.0"
        },
        "status": {
          "const": "GENERATED_DRAFT"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "parser": {
          "$ref": "#/$defs/parser"
        },
        "schemas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/schema"
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byteLength",
        "context"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "context": {
          "$ref": "#/$defs/context"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string"
        },
        "client": {
          "type": "string"
        },
        "release": {
          "type": "string"
        }
      }
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "options"
      ],
      "properties": {
        "name": {
          "const": "migration-stream-edmx"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "options": {
          "$ref": "#/$defs/parserOptions"
        }
      }
    },
    "parserOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline",
        "namespacePrefixAgnostic",
        "rejectDocumentType",
        "externalResolution",
        "limits"
      ],
      "properties": {
        "offline": {
          "const": true
        },
        "namespacePrefixAgnostic": {
          "const": true
        },
        "rejectDocumentType": {
          "const": true
        },
        "externalResolution": {
          "const": false
        },
        "limits": {
          "$ref": "#/$defs/limits"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxInputBytes",
        "maxDepth",
        "maxEvents",
        "maxAttributesPerElement",
        "maxAttributeBytes",
        "maxTextBytes"
      ],
      "properties": {
        "maxInputBytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxDepth": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxEvents": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxAttributesPerElement": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxAttributeBytes": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxTextBytes": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "entityTypes",
        "associations",
        "entityContainers"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "entityTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityType"
          }
        },
        "associations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/association"
          }
        },
        "entityContainers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityContainer"
          }
        }
      }
    },
    "entityType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "properties",
        "navigationProperties"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "navigationProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navigationProperty"
          }
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "nullable": {
          "type": "boolean",
          "description": "The technical EDM Nullable facet; it is not a business required flag."
        },
        "maxLength": {
          "type": "string"
        },
        "precision": {
          "type": "string"
        },
        "scale": {
          "type": "string"
        }
      }
    },
    "navigationProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "partner": {
          "type": "string"
        },
        "relationship": {
          "type": "string"
        },
        "fromRole": {
          "type": "string"
        },
        "toRole": {
          "type": "string"
        },
        "collection": {
          "type": "boolean"
        },
        "cardinality": {
          "enum": [
            "0..1",
            "1",
            "0..*"
          ]
        }
      }
    },
    "association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ends"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/associationEnd"
          }
        }
      }
    },
    "associationEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "type",
        "multiplicity"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "multiplicity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entityContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "entitySets"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entitySets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entitySet"
          }
        }
      }
    },
    "entitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "entityType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hashEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sha256",
        "serialization",
        "scope"
      ],
      "properties": {
        "algorithm": {
          "const": "SHA-256"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "serialization": {
          "const": "migration-stream-technical-catalogue-json-v1"
        },
        "scope": {
          "const": "compact JSON serialization of catalogue; evidence excluded"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    }
  }
}
