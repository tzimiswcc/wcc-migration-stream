          "label": "Customer identifier",
          "logicalType": "identifier",
          "required": true,
          "sensitive": false
        },
        {
          "fieldId": "documentDate",
          "label": "Document date",
          "logicalType": "date",
          "required": true,
          "sensitive": false
        },
        {
          "fieldId": "documentType",
          "label": "Document type",
          "logicalType": "code",
          "required": true,
          "sensitive": false
        },
        {
          "fieldId": "currency",
          "label": "Currency",
          "logicalType": "currency",
          "required": true,
          "sensitive": false
        },
        {
          "fieldId": "sellingUnit",
          "label": "Selling unit",
          "logicalType": "code",
          "required": true,
          "sensitive": false
        },
        {
          "fieldId": "customerReference",
          "label": "Customer reference",
